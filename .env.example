# Prototipo local. Debe ser "false" en Preview y Production de Vercel.
NEXT_PUBLIC_DEMO_MODE=true

# Completar únicamente cuando el propietario indique el proyecto Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Activar solo después de aplicar la migración offline y probar el equipo piloto.
NEXT_PUBLIC_OFFLINE_MODE=false

# Par de claves JWK ES256. La privada solo existe en servidor; la pública se integra en la PWA.
OFFLINE_LEASE_PRIVATE_JWK=
NEXT_PUBLIC_OFFLINE_LEASE_PUBLIC_JWK=

# Solo servidor. Preferir la nueva secret key; service_role se mantiene por compatibilidad.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
