# Prototipo local. Debe ser "false" en Preview y Production de Vercel.
NEXT_PUBLIC_DEMO_MODE=true

# Completar únicamente cuando el propietario indique el proyecto Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. Nunca usar una service-role key con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
